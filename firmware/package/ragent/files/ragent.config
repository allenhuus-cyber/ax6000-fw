config main 'main'
	option listen ':8080'
	option data_dir '/etc/ragent'
	option dns_port '5353'
	option scan_interval '10'
	option name 'Redmi AX6000'
	option log_level 'info'

# 云端中继：开启后可在外网管理路由器并接收终端上线推送
config cloud 'cloud'
	option enabled '0'
	option url 'wss://cloud.example.com/device'
	option token ''
