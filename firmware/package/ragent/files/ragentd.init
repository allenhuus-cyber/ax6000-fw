#!/bin/sh /etc/rc.common
# ragentd —— 路由器控制代理
# procd 托管，崩溃自动重启
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/ragentd
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/ragentd.pid
    procd_close_instance
}

stop_service() {
    # 退出时清理自建的 nftables 表，避免残留规则影响网络
    nft delete table inet ragent 2>/dev/null
}

reload_service() {
    restart
}

service_triggers() {
    procd_add_reload_trigger network wireless dhcp firewall
}
