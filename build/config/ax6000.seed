# 追加到 OpenWrt .config 的构建选项（红米 AX6000 / MT7986A）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000=y

# 控制代理本体
CONFIG_PACKAGE_ragent=y

# DPI 应用过滤（OpenAppFilter）
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-appfilter=y
CONFIG_PACKAGE_luci-app-appfilter=y

# nftables 与 NAT 重定向（终端拉黑 / DNS 过滤重定向）
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y

# 限速（tc + htb + cls_basic）
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-htb=y
CONFIG_PACKAGE_kmod-sched-fq-codel=y
CONFIG_PACKAGE_kmod-cls-basic=y

# ubus / rpcd（session 登录用于配对）
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y

# 无线客户端查询与扫描
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-openssl=y

# PPPoE 拨号
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y

# 调试与诊断
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_qrencode=y
